{
  "manifest_version": 3,
  "name": "PhishLens",
  "version": "2.0.0",
  "description": "Warns about phishing emails in Gmail and explains why. Emails are analysed inside your browser and never sent anywhere.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "PhishLens",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": [
        "content/selectors.js",
        "content/payload.js",
        "content/banner.js",
        "content/gmail.js"
      ],
      "css": ["content/banner.css"]
    }
  ]
}
